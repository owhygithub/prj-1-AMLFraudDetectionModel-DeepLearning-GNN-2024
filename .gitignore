# --- Data -------------------------------------------------------------------
# The IBM synthetic AML transaction files and anything derived from them stay
# out of version control. See README.md for where to download them.
# Leading slash matters: a bare `data/` would also swallow webapp/public/data,
# which holds the demo bundle the deployed site needs.
/data/
*.csv
*.csv.gz
*.parquet
!results/runs.csv

# Cached graphs, checkpoints and prediction tensors
/artifacts/

# Output of your own runs. results/ is the committed 2024 record and is kept.
/output/

# Regenerate with `python webapp/reference_scores.py`; only needed to run
# `node webapp/verify_model.mjs`.
webapp/public/data/reference-scores.json
*.pt
*.pth
*.pickle
*.pkl
*.npz

# --- Local scratch ----------------------------------------------------------
# Papers, the thesis proposal, superseded scripts and archived notebooks: kept
# on disk, deliberately not published.
_local/

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
build/
dist/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- Tooling & OS -----------------------------------------------------------
.vscode/
.claude/
.idea/
.DS_Store
Thumbs.db

# Optuna study databases
*.db
*.sqlite3
